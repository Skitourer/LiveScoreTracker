# Copy this file to `.env` (never committed) and adjust the values.
# On the server, `.env` sits in the project root, outside the public web folder.

# production | test | development
APP_ENV=development
# Show detailed errors (never true in production)
APP_DEBUG=true

# Public address of the site, without trailing "/" (used in email links)
APP_URL=http://localhost:8000

# Time zone used to display dates and times
APP_TIMEZONE=Europe/Paris

# Inactivity before a session expires, in minutes
SESSION_IDLE_MINUTES=240

# Private data folder (cache, SQLite file, backups), relative to the project root or absolute
DATA_DIR=data

# Database: sqlite (development, tests) or mysql (servers)
DB_DRIVER=sqlite
DB_SQLITE_PATH=app.sqlite

# MySQL settings (used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Long random string; enables POST /internal/migrate for the deployment workflow
# and is asked once to create the first admin account at /setup
DEPLOY_TOKEN=

# Emails: "smtp" to send, "log" to write them to data/logs/mail.log (development)
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=465
# ssl (port 465) or tls (port 587)
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=LiveScoreTracker
