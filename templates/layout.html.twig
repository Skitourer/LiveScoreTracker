<!doctype html>
<html lang="{{ lang|default('fr') }}" dir="{{ dir|default('ltr') }}" data-base="{{ base_path() }}" data-revision="{{ app_revision }}" data-live-text="{{ t('live.updated_at') }}" data-offline-text="{{ t('offline.needs_network') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="{% block robots %}noindex, nofollow{% endblock %}">
    <title>{% block title %}{{ t('app.name') }}{% endblock %}</title>
    <link rel="manifest" href="{{ base_path() }}/manifest.webmanifest">
    {% set brand = theme() %}
    <meta name="theme-color" content="{{ brand.accent ?? '#1f5fbf' }}">
    <link rel="apple-touch-icon" href="{{ base_path() }}/assets/icons/icon-192.png">
    <link rel="stylesheet" href="{{ base_path() }}/assets/css/tokens.css">
    <link rel="stylesheet" href="{{ base_path() }}/assets/css/app.css">
    {% if brand.accent %}<link rel="stylesheet" href="{{ base_path() }}/theme.css?c={{ brand.accent|slice(1) }}">{% endif %}
    <script type="module" src="{{ base_path() }}/assets/js/app.js"></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="{{ logged_in() ? url_for('dashboard') : url_for('home') }}">{% if brand.logo %}<img class="brand-logo" src="{{ base_path() }}/logo?v={{ brand.logo }}" alt=""> {% endif %}{{ t('app.name') }}</a>
        {% block topbar_nav %}<nav class="topbar-nav">
            {% set me = current_user() %}
            {% if me %}
                {% if me.role.value == 'referee' %}
                    <a href="{{ url_for('referee-name') }}" class="who">{{ referee_name() }} <small>· {{ t('role.referee') }}</small></a>
                {% else %}
                    <a href="{{ url_for('account') }}" class="who">{{ me.displayName }} <small>· {{ t('role.' ~ me.role.value) }}</small></a>
                {% endif %}
            {% endif %}
            {% if logged_in() %}
                <form method="post" action="{{ url_for('logout') }}" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="link">{{ t('nav.logout') }}</button>
                </form>
            {% else %}
                <a href="{{ url_for('login') }}">{{ t('nav.login') }}</a>
            {% endif %}
        </nav>{% endblock %}
    </header>
    <main class="container{% block main_class %}{% endblock %}">
        {% block flashes %}
            {% for flash in flashes() %}
                <p class="flash {{ flash.type }}" role="status">{{ t(flash.key, flash.params) }}</p>
            {% endfor %}
        {% endblock %}
        {% block content %}{% endblock %}
    </main>
</body>
</html>
