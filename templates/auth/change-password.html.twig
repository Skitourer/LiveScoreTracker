{% extends 'layout.html.twig' %}

{% block title %}{{ t('password.change_title') }}{% endblock %}

{% block content %}
    <h1>{{ t('password.change_title') }}</h1>
    {% if forced %}<p class="notice">{{ t('password.change_forced') }}</p>{% endif %}
    {% include 'partials/errors.html.twig' %}
    <form method="post" action="{{ url_for('account-password') }}" class="form">
        {{ csrf_field() }}
        <label>{{ t('password.current') }}
            <input type="password" name="current_password" autocomplete="current-password" required autofocus>
        </label>
        <label>{{ t('password.new') }} <small>{{ t('password.rule', {min: min}) }}</small>
            <input type="password" name="password" autocomplete="new-password" minlength="{{ min }}" required>
        </label>
        <label>{{ t('password.confirm') }}
            <input type="password" name="password_confirm" autocomplete="new-password" minlength="{{ min }}" required>
        </label>
        <button type="submit" class="button">{{ t('password.save') }}</button>
    </form>
{% endblock %}
