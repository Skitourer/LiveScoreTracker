{% extends 'layout.html.twig' %}

{% block title %}{{ t('password.forgot_title') }}{% endblock %}

{% block content %}
    <h1>{{ t('password.forgot_title') }}</h1>
    {% if sent %}
        <p class="notice">{{ t('password.forgot_sent') }}</p>
        <p><a href="{{ url_for('login') }}">{{ t('password.back_to_login') }}</a></p>
    {% else %}
        <p>{{ t('password.forgot_intro') }}</p>
        <form method="post" action="{{ url_for('password-forgot') }}" class="form">
            {{ csrf_field() }}
            <label>{{ t('account.email') }}
                <input type="email" name="email" autocomplete="email" required autofocus>
            </label>
            <button type="submit" class="button">{{ t('password.forgot_submit') }}</button>
        </form>
    {% endif %}
{% endblock %}
