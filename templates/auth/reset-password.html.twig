{% extends 'layout.html.twig' %}

{% block title %}{{ t('password.reset_title') }}{% endblock %}

{% block content %}
    <h1>{{ t('password.reset_title') }}</h1>
    {% if invalid %}
        <p class="notice error">{{ t('password.reset_invalid') }}</p>
        <p><a href="{{ url_for('password-forgot') }}">{{ t('password.forgot_title') }}</a></p>
    {% else %}
        {% include 'partials/errors.html.twig' %}
        <form method="post" class="form">
            {{ csrf_field() }}
            <label>{{ t('password.new') }} <small>{{ t('password.rule', {min: min}) }}</small>
                <input type="password" name="password" autocomplete="new-password" minlength="{{ min }}" required autofocus>
            </label>
            <label>{{ t('password.confirm') }}
                <input type="password" name="password_confirm" autocomplete="new-password" minlength="{{ min }}" required>
            </label>
            <button type="submit" class="button">{{ t('password.save') }}</button>
        </form>
    {% endif %}
{% endblock %}
