{% extends 'layout.html.twig' %}

{% block title %}{{ t('two_factor.setup_title') }}{% endblock %}

{% block content %}
    <h1>{{ t('two_factor.setup_title') }}</h1>
    <p>{{ t('two_factor.setup_intro') }}</p>
    <ol class="steps">
        <li>{{ t('two_factor.setup_step_app') }}</li>
        <li>{{ t('two_factor.setup_step_scan') }}
            <div class="qr">{{ qr|raw }}</div>
            <p class="meta">{{ t('two_factor.setup_manual') }}<br><code class="secret">{{ secret }}</code></p>
        </li>
        <li>{{ t('two_factor.setup_step_code') }}</li>
    </ol>
    {% include 'partials/errors.html.twig' %}
    <form method="post" action="{{ url_for('account-2fa') }}" class="form">
        {{ csrf_field() }}
        <label>{{ t('two_factor.code') }}
            <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required>
        </label>
        <button type="submit" class="button">{{ t('two_factor.setup_submit') }}</button>
    </form>
{% endblock %}
