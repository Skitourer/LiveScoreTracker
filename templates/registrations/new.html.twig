{% extends 'layout.html.twig' %}

{% block title %}{{ t('registration.add') }}{% endblock %}

{% block content %}
    <p><a href="{{ url_for('registrations') }}">← {{ t('registration.title') }}</a></p>
    <h1>{{ t('registration.add') }}</h1>
    {% if onSite %}<p class="notice">{{ t('registration.on_site_notice') }}</p>{% endif %}
    {% include 'partials/errors.html.twig' %}
    <form method="post" action="{{ url_for('registration-new') }}" class="form wide-form">
        {{ csrf_field() }}
        {% include 'registrations/_fields.html.twig' with {birthOptional: onSite} %}
        <label class="choice"><input type="checkbox" name="send_email" value="1" {% if sendEmail %}checked{% endif %}> {{ t('registration.send_email') }}</label>
        <div class="toolbar">
            <button type="submit" class="button">{{ t('registration.save') }}</button>
            <button type="submit" name="another" value="1" class="button secondary">{{ t('registration.save_and_another') }}</button>
        </div>
    </form>
{% endblock %}
