{% extends 'layout.html.twig' %}

{% macro device_action(op, device, style) %}
    <form method="post" class="inline" {% if op == 'block' %}data-confirm="{{ t('referee.confirm_block', {name: device.referee_name}) }}"{% endif %}>
        {{ csrf_field() }}
        <input type="hidden" name="op" value="{{ op }}">
        <input type="hidden" name="device" value="{{ device.device_id }}">
        <button type="submit" class="button small {{ style }}">{{ t('referee.action.' ~ op) }}</button>
    </form>
{% endmacro %}

{% block title %}{{ t('referee.title') }}{% endblock %}

{% block content %}
    <h1>{{ t('referee.title') }}</h1>
    <p>{{ t('referee.intro') }}</p>
    {% if phase() != 'running' %}<p class="notice">{{ t('referee.inactive_now') }}</p>{% endif %}
    {% include 'partials/errors.html.twig' %}

    {% if account is null %}
        <form method="post" class="form">
            {{ csrf_field() }}
            <input type="hidden" name="op" value="create">
            <label>{{ t('account.username') }} <small>{{ t('account.username_rule') }}</small>
                <input type="text" name="username" value="{{ username }}" autocapitalize="none" spellcheck="false" required>
            </label>
            <label>{{ t('referee.password') }} <small>{{ t('password.rule', {min: min}) }}</small>
                <input type="text" name="password" autocomplete="off" minlength="{{ min }}" required>
            </label>
            <button type="submit" class="button">{{ t('referee.create') }}</button>
        </form>
    {% else %}
        <dl class="facts">
            <dt>{{ t('account.username') }}</dt><dd><code>{{ account.username }}</code></dd>
        </dl>

        <h2>{{ t('referee.phones', {count: connectedCount}) }}</h2>
        <p class="meta">{{ t('referee.devices_intro') }}</p>
        {% if devices is empty and unnamed is empty %}
            <p class="meta">{{ t('referee.no_phone') }}</p>
        {% else %}
            <div class="table-scroll">
                <table>
                    <thead><tr><th>{{ t('referee.who') }}</th><th>{{ t('referee.phone') }}</th><th></th></tr></thead>
                    <tbody>
                        {% for device in devices %}
                            {% set online = connected[device.device_id] is defined %}
                            <tr{% if device.blocked %} class="highlight"{% endif %}>
                                <td>
                                    <strong>{{ device.referee_name }}</strong>
                                    {% if device.blocked %}<span class="badge error">{{ t('referee.blocked') }}</span>
                                    {% elseif online %}<span class="badge ok">{{ t('referee.online') }}</span>{% endif %}
                                    <br><small class="muted">{{ t('referee.last_seen', {at: local_time(device.last_seen_at)}) }}</small>
                                </td>
                                <td><code>{{ device.device_id|slice(0, 6) }}</code><br><small class="muted">{{ device.user_agent|slice(0, 50) }}</small></td>
                                <td>
                                    <div class="toolbar">
                                        {% if online %}
                                            {{ _self.device_action('disconnect_device', device, 'secondary') }}
                                        {% endif %}
                                        {% if device.blocked %}
                                            {{ _self.device_action('unblock', device, 'secondary') }}
                                        {% else %}
                                            {{ _self.device_action('block', device, 'danger') }}
                                            {% if not online %}{{ _self.device_action('forget', device, 'secondary') }}{% endif %}
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        {% for phone in unnamed %}
                            <tr>
                                <td><em>{{ t('referee.no_name_yet') }}</em><br><small class="muted">{{ t('referee.last_seen', {at: local_time(phone.last_seen_at)}) }}</small></td>
                                <td><code>{{ phone.device_id|slice(0, 6) }}</code><br><small class="muted">{{ phone.user_agent|slice(0, 50) }}</small></td>
                                <td>{{ _self.device_action('disconnect_device', {device_id: phone.device_id, referee_name: '?'}, 'secondary') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        <p class="notice">{{ t('referee.block_limit') }}</p>
        <form method="post" class="form">
            {{ csrf_field() }}
            <input type="hidden" name="op" value="disconnect">
            <button type="submit" class="button danger">{{ t('referee.disconnect_all') }}</button>
        </form>

        <h2>{{ t('referee.change_password') }}</h2>
        <p class="meta">{{ t('referee.change_password_hint') }}</p>
        <form method="post" class="form">
            {{ csrf_field() }}
            <input type="hidden" name="op" value="password">
            <label>{{ t('referee.password') }} <small>{{ t('password.rule', {min: min}) }}</small>
                <input type="text" name="password" autocomplete="off" minlength="{{ min }}" required>
            </label>
            <button type="submit" class="button secondary">{{ t('referee.save_password') }}</button>
        </form>
    {% endif %}
{% endblock %}
