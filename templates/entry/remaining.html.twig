{% extends 'layout.html.twig' %}

{% block title %}{{ t('entry.remaining') }}{% endblock %}

{% block content %}
    {% include 'entry/_nav.html.twig' %}
    <h1>{{ t('entry.remaining') }}</h1>
    <ul class="stats">
        <li><strong>{{ remaining|length }}</strong> {{ t('entry.remaining_count') }}</li>
        <li><strong>{{ done }}</strong> {{ t('entry.done_count') }}</li>
    </ul>
    <form method="get" class="check-in-search" role="search">
        <label>{{ t('entry.remaining_search') }}
            <input type="search" name="q" value="{{ query }}" autocomplete="off">
        </label>
        <button type="submit" class="button secondary">{{ t('check_in.search') }}</button>
    </form>
    {% if remaining is empty %}
        <p class="meta">{{ t('entry.remaining_none') }}</p>
    {% else %}
        <div class="table-scroll">
            <table>
                <thead><tr><th class="num">{{ t('entry.bib') }}</th><th>{{ t('check_in.child') }}</th><th>{{ t('registration.field.level') }}</th><th>{{ t('entry.attempts_done') }}</th></tr></thead>
                <tbody>
                    {% for row in remaining %}
                        <tr>
                            <td class="num"><a href="{{ url_for('entry-child', {workshop: workshop.id, bib: row.child.bib}) }}"><span class="bib">{{ row.child.bib }}</span></a></td>
                            <td><a href="{{ url_for('entry-child', {workshop: workshop.id, bib: row.child.bib}) }}">{{ row.child.publicName() }}</a></td>
                            <td>{{ label('level.' ~ row.child.child.level) }}</td>
                            <td>{{ row.used }} / {{ row.variant.attempts }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
