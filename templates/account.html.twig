{% extends 'layout.html.twig' %}

{% block title %}{{ t('account.title') }}{% endblock %}

{% block content %}
    {% set me = current_user() %}
    <h1>{{ t('account.title') }}</h1>
    <dl class="facts">
        <dt>{{ t('account.username') }}</dt><dd>{{ me.username }}</dd>
        <dt>{{ t('account.role') }}</dt><dd>{{ t('role.' ~ me.role.value) }}</dd>
        {% if me.email %}<dt>{{ t('account.email') }}</dt><dd>{{ me.email }}</dd>{% endif %}
    </dl>
    {% if me.role.isIndividual() %}
        <p><a class="button secondary" href="{{ url_for('account-password') }}">{{ t('password.change_title') }}</a></p>
    {% endif %}

    {% if me.role.requiresTwoFactor() %}
        <h2>{{ t('two_factor.title') }}</h2>
        <p>{{ t('account.2fa_on', {count: remainingCodes}) }}</p>
        {% include 'partials/errors.html.twig' %}
        <form method="post" action="{{ url_for('account') }}" class="form">
            {{ csrf_field() }}
            <input type="hidden" name="op" value="new_codes">
            <label>{{ t('password.current') }}
                <input type="password" name="current_password" autocomplete="current-password" required>
            </label>
            <button type="submit" class="button secondary">{{ t('account.new_codes') }}</button>
        </form>

        <h2>{{ t('account.trusted_devices') }}</h2>
        <p class="meta">{{ t('account.trusted_devices_intro', {days: 30}) }}</p>
        {% if trustedDevices is empty %}
            <p class="meta">{{ t('account.no_trusted_device') }}</p>
        {% else %}
            <div class="table-scroll">
                <table>
                    <thead><tr><th>{{ t('referee.phone') }}</th><th>{{ t('account.trusted_until') }}</th><th></th></tr></thead>
                    <tbody>
                        {% for device in trustedDevices %}
                            <tr>
                                <td><small>{{ device.user_agent|slice(0, 60) }}</small>{% if device.device_id == currentDevice %}<br><span class="badge ok">{{ t('account.this_device') }}</span>{% endif %}</td>
                                <td>{{ local_time(device.expires_at) }}</td>
                                <td>
                                    <form method="post" class="inline">
                                        {{ csrf_field() }}
                                        <input type="hidden" name="op" value="revoke_device">
                                        <input type="hidden" name="device" value="{{ device.id }}">
                                        <button type="submit" class="button small secondary">{{ t('account.revoke') }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <form method="post" class="form" data-confirm="{{ t('account.revoke_all_confirm') }}">
                {{ csrf_field() }}
                <input type="hidden" name="op" value="revoke_all">
                <button type="submit" class="button danger">{{ t('account.revoke_all') }}</button>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}
