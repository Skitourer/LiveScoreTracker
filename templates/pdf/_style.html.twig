{# Shared PDF styles (Dompdf): inline styles are fine here, these pages are never served as HTML. #}
<style>
    @page { margin: 16mm 12mm 14mm; }
    body { font-family: "DejaVu Sans", sans-serif; font-size: 11pt; color: #000; }
    header { position: fixed; top: -11mm; left: 0; right: 0; font-size: 8.5pt; color: #555; }
    header .provisional { float: right; color: #000; font-weight: bold; }
    footer { position: fixed; bottom: -10mm; left: 0; right: 0; font-size: 8.5pt; color: #555; text-align: right; }
    footer .page:after { content: counter(page); }
    h1 { font-size: 18pt; margin: 0 0 2mm; }
    h2 { font-size: 14pt; margin: 4mm 0 2mm; }
    .intro { margin: 0 0 3mm; font-size: 10pt; }
    .break { page-break-before: always; }
    .keep { page-break-inside: avoid; }
    table { width: 100%; border-collapse: collapse; }
    thead { display: table-header-group; }
    thead th { font-size: 9pt; text-align: left; border-bottom: 1.5pt solid #000; padding: 1.2mm 1.5mm; }
    td { padding: 1.5mm; border-bottom: 0.5pt solid #999; vertical-align: top; }
    .num { text-align: right; }
    .bib { text-align: right; font-weight: bold; width: 14mm; }
    .last { text-transform: uppercase; }
    .small { font-size: 8.5pt; color: #333; }
    .stamp { border: 1.5pt solid #000; padding: 1mm 3mm; font-weight: bold; }
</style>
