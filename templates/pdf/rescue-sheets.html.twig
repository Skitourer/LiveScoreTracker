<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<title>{{ t('documents.rescue_sheets.title') }}</title>
{% include 'pdf/_style.html.twig' %}
<style>
    td { vertical-align: middle; }
    td.box { border: 0.5pt solid #000; height: 7mm; }
    td.check { width: 12mm; text-align: center; font-size: 13pt; }
    td.blank { height: 7mm; }
    .sheet-head td { border: 0; padding: 0 0 2mm; font-size: 10pt; }
</style>
</head>
<body>
<header>{{ edition.name }} — {{ edition.date|date('d/m/Y') }}</header>
<footer>{{ t('documents.state_at', {at: local_time(printedAt)}) }} · {{ t('reception_list.page') }} <span class="page"></span></footer>
{% for sheet in sheets %}
    {% set variant = sheet.variant %}
    {% set columns = variant.measure.value == 'counter' and variant.attempts == 1 ? [t('documents.col.count')] : range(1, variant.attempts)|map(n => t('documents.col.attempt', {n: n})) %}
    <div{% if not loop.first %} class="break"{% endif %}>
        <h1>{{ event_label(variant) }}</h1>
        <table class="sheet-head"><tr>
            <td>{{ t('documents.rescue_sheets.levels', {levels: sheet.levels|map(l => label('level.' ~ l))|join(', ')}) }}<br>
                {{ t('documents.unit.' ~ variant.measure.value) }}{% if variant.modifiers is not empty %} · {{ t('documents.col.modifiers') }} : {{ variant.modifiers|map(m => t('modifier.' ~ m.id) ~ ' (' ~ (m.value > 0 ? '+' : '') ~ m.value ~ ')')|join(', ') }}{% endif %}</td>
            <td class="num">{{ t('documents.rescue_sheets.referee') }} ____________________<br>{{ t('documents.state_at', {at: local_time(printedAt)}) }}</td>
        </tr></table>
        <table>
            <thead><tr>
                <th class="bib">{{ t('documents.col.bib') }}</th>
                <th>{{ t('documents.col.child') }}</th>
                <th>{{ t('registration.field.level') }}</th>
                <th>{{ t('documents.col.present') }}</th>
                {% for column in columns %}<th>{{ column }}</th>{% endfor %}
                {% if variant.modifiers is not empty %}<th>{{ t('documents.col.modifiers') }}</th>{% endif %}
                <th>{{ t('documents.col.notes') }}</th>
            </tr></thead>
            <tbody>
            {% for child in sheet.children %}
                <tr>
                    <td class="bib">{{ child.bib }}</td>
                    <td><span class="last">{{ child.child.lastName }}</span> {{ child.child.firstName }}</td>
                    <td class="small">{{ label('level.' ~ child.child.level) }} {{ t('gender.' ~ child.child.gender ~ '.one')|slice(0, 1) }}</td>
                    <td class="check">☐</td>
                    {% for column in columns %}<td class="box"></td>{% endfor %}
                    {% if variant.modifiers is not empty %}<td class="box"></td>{% endif %}
                    <td class="box"></td>
                </tr>
            {% endfor %}
            {% for i in 1..blankLines %}
                <tr>
                    <td class="box blank"></td><td class="box"></td><td class="box"></td><td class="check">☐</td>
                    {% for column in columns %}<td class="box"></td>{% endfor %}
                    {% if variant.modifiers is not empty %}<td class="box"></td>{% endif %}
                    <td class="box"></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p>{{ t('documents.empty') }}</p>
{% endfor %}
</body>
</html>
