{
  "name": "livescoretracker",
  "private": true,
  "description": "Front-end tooling (lint and formatting) for LiveScoreTracker. No build step.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint public/assets/js && prettier --check \"public/assets/**/*.{js,css}\"",
    "format": "prettier --write \"public/assets/**/*.{js,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
